#compdef ucloud

_get_workspaces() {
    local -a workspaces
    workspaces=(
        'foo:Production workspace'
        'bar:Development workspace'
    )

    _describe 'workspace' workspaces
}

_ucloud() {

    # ucloud <TAB>
    if (( CURRENT == 2 )); then
        local -a routes

        routes=(

            ''completion''

            ''workspace''

        )

        compadd -a routes
        return
    fi

    case "$words[2]" in


        'completion')

            # ucloud <route> <TAB>
            if (( CURRENT == 3 )); then
                local -a subcommands

                subcommands=(

                    ''completion''

                )

                compadd -a subcommands
                return
            fi

            case "$words[3]" in


                'completion')

                    local -a flags

                    flags=(


                        ''--generate':'Generate completion script''




                    )

                    _describe 'flag' flags
                    return
                    ;;


            esac
            ;;


        'workspace')

            # ucloud <route> <TAB>
            if (( CURRENT == 3 )); then
                local -a subcommands

                subcommands=(

                    ''list''

                    ''use''

                    ''get''

                    ''rename''

                )

                compadd -a subcommands
                return
            fi

            case "$words[3]" in


                'list')

                    local -a flags

                    flags=(

                    )

                    _describe 'flag' flags
                    return
                    ;;


                'use')

                    local -a flags

                    flags=(




                        add ''name':'Workspace name''


                    )

                    _describe 'flag' flags
                    return
                    ;;


                'get')

                      case "$CURRENT" in
                      4)
                         flags=(
                           'from:name'
                           'to:name'
                         )
                         _describe 'flag' flags
                         ;;
                      5)
                         flags=(
                           'from:name'
                           'to:name'
                         )
                         _describe 'flag' flags
                         ;;
                      esac
                      ;;

                'rename')

                    local -a flags


                    flags=(
                        from
                    )
                    _message 'workspace name: source file'

                    _describe 'flag' flags
                    return
                    ;;


            esac
            ;;


    esac
}

compdef _ucloud ucloud