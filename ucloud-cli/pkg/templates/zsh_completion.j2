#compdef ucloud

_ucloud() {

    # ucloud <TAB>
    if (( CURRENT == 2 )); then
        local -a routes

        routes=(
{% for command in commands %}
            '{{ command.Name }}'
{% endfor %}
        )

        compadd -a routes
        return
    fi

    case "$words[2]" in

{% for command in commands %}
        {{ command.Name }})

            # ucloud <route> <TAB>
            if (( CURRENT == 3 )); then
                local -a subcommands

                subcommands=(
{% for subcommand in command.SubCommands %}
                    '{{ subcommand.Name }}'
{% endfor %}
                )

                compadd -a subcommands
                return
            fi

            case "$words[3]" in

{% for subcommand in command.SubCommands %}
                {{ subcommand.Name }})

                    local -a flags

                    flags=(
{% for flag in subcommand.Flags %}
{% if flag.FlagType == "flag" %}
                        '{{ flag.Name }}:{{ flag.Usage }}'
{% endif %}

{% if flag.FlagType == "positional" %}
                        add '{{ flag.Name }}:{{ flag.Usage }}'
{% endif %}
{% endfor %}
                    )

                    _describe 'flag' flags
                    return
                    ;;

{% endfor %}
            esac
            ;;

{% endfor %}
    esac
}

compdef _ucloud ucloud